{
  "name": "call-guide-editor",
  "displayName": "アイドルコール辞書エディタ (Call Guide Studio)",
  "description": "YouTube動画を見ながら再生範囲・歌詞・コールを入力して辞書コードを自動生成するVS Code拡張機能",
  "version": "1.0.0",
  "publisher": "call-guide",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:callGuide.openEditor",
    "*"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "callGuide.openEditor",
        "title": "Call Guide: コール作成エディタを開く",
        "category": "Call Guide",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "callGuide.openEditor",
          "group": "navigation"
        }
      ]
    }
  }
}
